{
  "name": "@receipt-divider/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/node.ts",
    "dev:local": "node --env-file=.env.local --import tsx --watch src/node.ts",
    "start": "tsx src/node.ts",
    "start:local": "node --env-file=.env.local --import tsx src/node.ts",
    "deploy:edge": "supabase functions deploy ledger-api --project-ref lurdfvsnscylvwvvepos --use-api --no-verify-jwt --workdir ../..",
    "migrate:friends": "node --env-file=.env.local --import tsx scripts/apply-migration.ts db/migrations/002_profiles_and_friends.sql",
    "smoke:postgres": "node --env-file=.env.local --import tsx scripts/smoke-postgres.ts",
    "smoke:friends": "node --env-file=.env.local --import tsx scripts/smoke-friends.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/api.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.5",
    "hono": "^4.9.9",
    "jose": "^6.2.12",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "supabase": "^2.118.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
